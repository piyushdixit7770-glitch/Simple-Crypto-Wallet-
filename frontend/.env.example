# Simple Crypto Wallet — Frontend Environment Variables
# Copy this file to .env.local and fill in the values.

# Target network (preview | preprod | undeployed)
VITE_NETWORK=preview

# Contract address after deployment (run: npm run deploy -- --network preview)
VITE_CONTRACT_ADDRESS=

# Indexer GraphQL endpoint (default: Preview Network)
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
